# Copy values into the Windows VPS environment. Do not commit real secrets.
FOREX_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
FOREX_DB_PATH=C:\\ForexAI\\data\\forex_demo.db
SIGNAL_STALE_SECONDS=300

# MongoDB Atlas mirror for public read-only Paper candles (set as a Render secret).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=forex_market
MONGODB_CANDLES_COLLECTION=paper_candles
